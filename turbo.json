{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "REDIS_URL",
    "REDIS_KEY_PREFIX",
    "GITHUB_ID",
    "GITHUB_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_ACCESS_KEY",
    "AWS_SECRET_KEY",
    "AWS_DEFAULT_REGION",
    "AWS_SES_ENDPOINT",
    "AWS_SNS_ENDPOINT",
    "NODE_ENV",
    "VERCEL_URL",
    "VERCEL",
    "SKIP_ENV_VALIDATION",
    "DOCKER_OUTPUT",
    "PORT",
    "UNSEND_API_KEY",
    "USESEND_API_KEY",
    "NEXT_PUBLIC_IS_CLOUD",
    "NEXT_PUBLIC_APP_VERSION",
    "NEXT_PUBLIC_GIT_SHA",
    "S3_COMPATIBLE_ACCESS_KEY",
    "S3_COMPATIBLE_SECRET_KEY",
    "S3_COMPATIBLE_API_URL",
    "S3_COMPATIBLE_PUBLIC_URL",
    "S3_COMPATIBLE_BUCKET",
    "STRIPE_SECRET_KEY",
    "STRIPE_BASIC_PRICE_ID",
    "STRIPE_BASIC_USAGE_PRICE_ID",
    "STRIPE_LEGACY_BASIC_PRICE_ID",
    "STRIPE_WEBHOOK_SECRET",
    "SMTP_HOST",
    "SMTP_USER",
    "FROM_EMAIL",
    "ADMIN_EMAIL",
    "FOUNDER_EMAIL",
    "API_RATE_LIMIT",
    "AUTH_EMAIL_RATE_LIMIT",
    "SHOPIFY_API_KEY",
    "SHOPIFY_API_SECRET",
    "SHOPIFY_SCOPES",
    "SHOPIFY_APP_URL",
    "SHOPIFY_THEME_EXTENSION_UID",
    "SHOPIFY_SYNC_CUSTOMER_DATA",
    "OPENAI_API_KEY",
    "OPENAI_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_URL",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "AWS_SECRET_KEY",
        "AWS_ACCESS_KEY",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ACCESS_KEY_ID",
        "AWS_DEFAULT_REGION",
        "AWS_SES_ENDPOINT",
        "AWS_SNS_ENDPOINT",
        "NEXTAUTH_SECRET",
        "NODE_ENV",
        "VERCEL_URL",
        "VERCEL",
        "SKIP_ENV_VALIDATION",
        "DOCKER_OUTPUT",
        "PORT",
        "UNSEND_API_KEY",
        "USESEND_API_KEY",
        "REDIS_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_IS_CLOUD",
        "S3_COMPATIBLE_ACCESS_KEY",
        "S3_COMPATIBLE_SECRET_KEY",
        "S3_COMPATIBLE_API_URL",
        "S3_COMPATIBLE_PUBLIC_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "db:generate"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
